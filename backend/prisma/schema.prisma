  approved_at          DateTime?             @db.DateTime(0)
  staff_account        staff_account?        @relation(fields: [approved_by_staff_id], references: [staff_account_id], onDelete: Restrict, onUpdate: Restrict, map: "fk_bm_approved_staff")
  admission_batch      admission_batch       @relation(fields: [batch_id], references: [batch_id], onUpdate: Restrict, map: "fk_bm_batch")
  admission_major      admission_major       @relation(fields: [major_id], references: [major_id], onUpdate: Restrict, map: "fk_bm_major")
  admission_benchmark  admission_benchmark?
  admission_committee  admission_committee[]
  admission_condition  admission_condition[]
