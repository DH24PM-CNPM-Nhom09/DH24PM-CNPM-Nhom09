# Kết nối MariaDB (XAMPP mặc định: user root, không mật khẩu, cổng 3306)
DATABASE_URL="mysql://root:@localhost:3306/admission_db"

# Cổng chạy backend (frontend Next.js đã dùng 3000)
PORT=4000

# Bí mật ký JWT — đổi thành chuỗi ngẫu nhiên dài khi triển khai thật
JWT_SECRET="doi-chuoi-nay-thanh-chuoi-bi-mat-dai"
JWT_EXPIRES_IN="8h"

# Địa chỉ frontend được phép gọi API (CORS), nhiều địa chỉ cách nhau dấu phẩy
CORS_ORIGINS="http://localhost:3000"

# Google Sign-In thật (Google Cloud Console > Google Auth Platform > Clients > Web application,
# Authorized JavaScript origins: http://localhost:3000). Để trống = nút Google chạy bản demo.
GOOGLE_CLIENT_ID=""

# Chế độ phát triển: cho phép đăng nhập Google giả bằng token "dev:<email>".
# Khi CHƯA cấu hình SMTP bên dưới, mã OTP được in ra cửa sổ backend và hiện trên màn hình
# để thử. TẮT (false) khi triển khai thật.
DEV_AUTH_BYPASS=true

# Gửi email thật (mã xác thực đăng ký, quên mật khẩu, thông báo hồ sơ) qua Gmail.
# SMTP_USER: địa chỉ Gmail dùng để gửi.
# SMTP_PASS: "Mật khẩu ứng dụng" 16 ký tự tạo tại https://myaccount.google.com/apppasswords
#            (cần bật Xác minh 2 bước). KHÔNG dùng mật khẩu đăng nhập Gmail.
# Để trống 2 dòng này thì hệ thống không gửi mail, chỉ in mã ra cửa sổ backend.
SMTP_USER=""
SMTP_PASS=""
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
MAIL_FROM_NAME="Tuyển sinh Sau đại học - ĐH An Giang"

# Hoặc gửi email qua Resend (https://resend.com) — dùng khi máy chủ chặn cổng SMTP,
# VD Render bản miễn phí. Có RESEND_API_KEY thì ưu tiên Resend thay cho SMTP ở trên.
# MAIL_FROM phải thuộc tên miền đã xác minh trên Resend.
RESEND_API_KEY=""
MAIL_FROM=""

# Thư mục lưu tệp minh chứng
UPLOAD_DIR="./uploads"
# disk (mặc định) = lưu tệp vào UPLOAD_DIR; db = lưu trong bảng stored_file (migration v13),
# dùng khi máy chủ không giữ được ổ đĩa (Render bản miễn phí xóa ổ đĩa mỗi lần ngủ / khởi động lại)
UPLOAD_STORAGE="disk"

# Tác vụ tự động (phút/lần): hồ sơ quá hạn bổ sung, quá hạn xác nhận nhập học (gọi dự bị),
# đơn phúc khảo chưa nộp phí khi hết hạn. 0 = tắt (cán bộ bấm xử lý bằng tay).
AUTO_JOB_MINUTES=15

# Số lần gọi API đăng nhập / đăng ký / quên mật khẩu tối đa mỗi 10 phút cho 1 địa chỉ IP (0 = tắt)
AUTH_RATE_LIMIT=60

# ---- Chỉ dùng khi chạy bằng "npm run start:hosted" (Render...), xem frontend/TRIEN_KHAI_MIEN_PHI.md ----
# Tự tạo bảng khi CSDL còn trống (false = tắt)
DB_AUTO_INIT=true
# Mật khẩu tài khoản quantri@agu.edu.vn tạo lần đầu
SEED_ADMIN_PASSWORD=""
# true = nạp bộ dữ liệu mẫu (65 hồ sơ, 4 tài khoản cán bộ) thay cho chỉ 1 tài khoản quản trị;
# SEED_DEMO_PASSWORD = mật khẩu chung của các tài khoản mẫu (đừng dùng Demo@123 trên web công khai)
SEED_DEMO=false
SEED_DEMO_PASSWORD=""
