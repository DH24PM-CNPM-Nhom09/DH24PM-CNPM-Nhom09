// Prisma schema — bổ sung field khớp Frontend types.ts + OTP hash + Complaint
// Nguồn: ERD GD3 + contract frontend/web/src/lib/types.ts

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ===== Danh mục =====
model AdmissionBatch {
  batchId     BigInt    @id @default(autoincrement()) @map("batch_id")
  batchCode   String    @unique @map("batch_code") @db.VarChar(50)
  batchName   String?   @map("batch_name") @db.VarChar(200)
  degreeLevel String    @map("degree_level") @db.VarChar(30)
  status      String    @db.VarChar(30)
  deletedAt   DateTime? @map("deleted_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  batchMajors AdmissionBatchMajor[]

  @@map("admission_batch")
}

model AdmissionMajor {
  majorId     BigInt  @id @default(autoincrement()) @map("major_id")
  majorCode   String  @unique @map("major_code") @db.VarChar(50)
  majorName   String? @map("major_name") @db.VarChar(200)
  degreeLevel String  @map("degree_level") @db.VarChar(30)
  status      String  @db.VarChar(30)

  batchMajors AdmissionBatchMajor[]

  @@map("admission_major")
}

model AdmissionBatchMajor {
  batchMajorId   BigInt   @id @default(autoincrement()) @map("batch_major_id")
  batchId        BigInt   @map("batch_id")
  majorId        BigInt   @map("major_id")
  quota          Int
  benchmarkScore Decimal? @map("benchmark_score") @db.Decimal(5, 2)
  status         String   @db.VarChar(30)

  batch        AdmissionBatch  @relation(fields: [batchId], references: [batchId])
  major        AdmissionMajor  @relation(fields: [majorId], references: [majorId])
  applications Application[]

  @@map("admission_batch_major")
}

// ===== Staff (rút gọn cho JWT staff nếu cần) =====
model StaffAccount {
  staffAccountId BigInt  @id @default(autoincrement()) @map("staff_account_id")
  staffCode      String  @unique @map("staff_code") @db.VarChar(50)
  email          String  @unique @db.VarChar(150)
  passwordHash   String? @map("password_hash") @db.VarChar(255)
  status         String  @db.VarChar(30)

  staffRoles StaffRole[]

  @@map("staff_account")
}

model Role {
  roleId   BigInt @id @default(autoincrement()) @map("role_id")
  roleCode String @unique @map("role_code") @db.VarChar(50)
  roleName String @map("role_name") @db.VarChar(100)

  staffRoles StaffRole[]

  @@map("role")
}

model StaffRole {
  staffRoleId    BigInt @id @default(autoincrement()) @map("staff_role_id")
  staffAccountId BigInt @map("staff_account_id")
  roleId         BigInt @map("role_id")

  staffAccount StaffAccount @relation(fields: [staffAccountId], references: [staffAccountId])
  role         Role         @relation(fields: [roleId], references: [roleId])

  @@map("staff_role")
}

// ===== Thí sinh =====
model CandidateAccount {
  accountId    BigInt  @id @default(autoincrement()) @map("account_id")
  username     String  @unique @db.VarChar(50)
  email        String  @unique @db.VarChar(150)
  phoneNumber  String  @unique @map("phone_number") @db.VarChar(20)
  passwordHash String? @map("password_hash") @db.VarChar(255)
  status       String  @db.VarChar(30)

  otps      OtpVerification[]
  candidate Candidate?

  @@map("candidate_account")
}

model OtpVerification {
  otpId       BigInt   @id @default(autoincrement()) @map("otp_id")
  accountId   BigInt   @map("account_id")
  purpose     String   @db.VarChar(30)
  otpCodeHash String   @map("otp_code_hash") @db.VarChar(255)
  expiresAt   DateTime @map("expires_at")
  createdAt   DateTime @default(now()) @map("created_at")

  account CandidateAccount @relation(fields: [accountId], references: [accountId])

  @@index([accountId, purpose])
  @@map("otp_verification")
}

model Candidate {
  candidateId BigInt    @id @default(autoincrement()) @map("candidate_id")
  accountId   BigInt    @unique @map("account_id")
  fullName    String    @map("full_name") @db.VarChar(150)
  idNumber    String?   @unique @map("id_number") @db.VarChar(20)
  dob         DateTime? @db.Date
  gender      String?   @db.VarChar(10)
  address     String?   @db.VarChar(255)

  account      CandidateAccount @relation(fields: [accountId], references: [accountId])
  applications Application[]

  @@map("candidate")
}

// ===== Hồ sơ =====
model Application {
  applicationId   BigInt    @id @default(autoincrement()) @map("application_id")
  applicationCode String    @unique @map("application_code") @db.VarChar(50)
  candidateId     BigInt    @map("candidate_id")
  batchMajorId    BigInt    @map("batch_major_id")
  reviewStatus    String    @default("DA_NOP") @map("review_status") @db.VarChar(30)
  admissionStatus String?   @map("admission_status") @db.VarChar(30)
  isCancelled     Boolean   @default(false) @map("is_cancelled")
  createdAt       DateTime  @default(now()) @map("created_at")

  candidate        Candidate           @relation(fields: [candidateId], references: [candidateId])
  batchMajor       AdmissionBatchMajor @relation(fields: [batchMajorId], references: [batchMajorId])
  documents        ApplicationDocument[]
  researchProposal ResearchProposal?

  @@map("application")
}

model ApplicationDocument {
  documentId    BigInt @id @default(autoincrement()) @map("document_id")
  applicationId BigInt @map("application_id")
  documentType  String @map("document_type") @db.VarChar(50)
  fileHash      String @map("file_hash") @db.VarChar(64)
  fileSizeKb    Int    @map("file_size_kb")
  fileName      String @default("") @map("file_name") @db.VarChar(255)
  verifyStatus  String @default("PENDING") @map("verify_status") @db.VarChar(20)

  application       Application        @relation(fields: [applicationId], references: [applicationId])
  researchProposals ResearchProposal[]

  @@map("application_document")
}

model Lecturer {
  lecturerId   BigInt  @id @default(autoincrement()) @map("lecturer_id")
  lecturerCode String  @unique @map("lecturer_code") @db.VarChar(50)
  fullName     String? @map("full_name") @db.VarChar(150)
  email        String  @unique @db.VarChar(150)
  facultyName  String? @map("faculty_name") @db.VarChar(200)
  status       String  @db.VarChar(30)

  proposedIn         ResearchProposal[]
  supervisorRequests SupervisorRequest[]

  @@map("lecturer")
}

model ResearchProposal {
  proposalId          BigInt @id @default(autoincrement()) @map("proposal_id")
  applicationId       BigInt @unique @map("application_id")
  documentId          BigInt @map("document_id")
  preferredLecturerId BigInt @map("preferred_lecturer_id")
  researchTopic       String @map("research_topic") @db.VarChar(255)

  application       Application         @relation(fields: [applicationId], references: [applicationId])
  document          ApplicationDocument @relation(fields: [documentId], references: [documentId])
  preferredLecturer Lecturer            @relation(fields: [preferredLecturerId], references: [lecturerId])
  supervisorRequests SupervisorRequest[]

  @@map("research_proposal")
}

model SupervisorRequest {
  requestId  BigInt   @id @default(autoincrement()) @map("request_id")
  proposalId BigInt   @map("proposal_id")
  lecturerId BigInt   @map("lecturer_id")
  status     String   @db.VarChar(30)
  createdAt  DateTime @default(now()) @map("created_at")

  proposal ResearchProposal @relation(fields: [proposalId], references: [proposalId])
  lecturer Lecturer         @relation(fields: [lecturerId], references: [lecturerId])

  @@map("supervisor_request")
}

// ===== Khiếu nại =====
model Complaint {
  complaintId     BigInt   @id @default(autoincrement()) @map("complaint_id")
  candidateId     BigInt   @map("candidate_id")
  applicationCode String   @map("application_code") @db.VarChar(50)
  type            String   @db.VarChar(50)
  content         String   @db.Text
  status          String   @default("PENDING") @db.VarChar(30)
  createdAt       DateTime @default(now()) @map("created_at")

  @@map("complaint")
}
