{
  "name": "tuyensinh-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Backend Hệ thống Quản lý Tuyển sinh Sau đại học — NestJS + Prisma + MariaDB",
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "dev": "nest start --watch",
    "prisma:generate": "prisma generate",
    "db:pull": "prisma db pull",
    "db:seed": "ts-node --transpile-only prisma/seed.ts",
    "db:seed:demo": "ts-node --transpile-only prisma/seed.ts --demo",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "db:update": "ts-node --transpile-only prisma/update.ts && prisma generate",
    "db:backup": "ts-node --transpile-only prisma/backup.ts"
  },
  "engines": {
    "node": ">=18.18"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.22",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.22",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/platform-express": "^10.4.22",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^2.4.3",
    "google-auth-library": "^9.15.1",
    "nodemailer": "^6.10.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/node": "^20.14.0",
    "@types/nodemailer": "^6.4.24",
    "prisma": "^6.19.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4"
  }
}
