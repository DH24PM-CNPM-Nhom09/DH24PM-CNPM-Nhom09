# Cấu hình frontend khi chạy "npm run dev" (không dùng Docker cho frontend).
# Chép file này thành .env.local rồi sửa. Next.js chỉ đọc file lúc khởi động:
# sửa xong phải tắt rồi chạy lại "npm run dev".
# Không có file .env.local = giao diện chạy bằng dữ liệu mẫu trong trình duyệt, không cần backend.

# Địa chỉ API backend (NestJS, cổng 4000)
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1

# false = gọi backend thật (cổng thí sinh / cổng cán bộ)
NEXT_PUBLIC_USE_MOCK=false
NEXT_PUBLIC_ADMIN_USE_MOCK=false

# true = hiện khung tài khoản demo ở trang đăng nhập cán bộ (chỉ để demo)
NEXT_PUBLIC_DEMO_LOGIN=true
