# Cấu hình cho docker compose — chép thành file .env (cùng thư mục docker-compose.yml) rồi sửa.
# KHÔNG đưa file .env lên GitHub.

# Mật khẩu MariaDB (chỉ dùng chữ và số để khỏi phải mã hóa trong DATABASE_URL)
DB_ROOT_PASSWORD=doimatkhauroot123
DB_USER=tuyensinh
DB_PASSWORD=doimatkhauapp123

# Cổng mở CSDL cho riêng máy này (HeidiSQL/DBeaver, backend chạy ngoài Docker). 3307 để không đụng XAMPP.
DB_PORT=3307

# Chuỗi bí mật ký phiên đăng nhập: ít nhất 32 ký tự ngẫu nhiên
JWT_SECRET=thay-bang-chuoi-ngau-nhien-that-dai-it-nhat-32-ky-tu

# Địa chỉ mà TRÌNH DUYỆT dùng để mở frontend / gọi backend
FRONTEND_URL=http://localhost:3000
BACKEND_PUBLIC_URL=http://localhost:4000

# true = cho đăng nhập Google giả "dev:<email>" và hiện mã OTP trên màn hình (CHỈ để demo)
DEV_AUTH_BYPASS=false
# true = hiện khung tài khoản demo ở trang đăng nhập cán bộ (CHỈ để demo)
DEMO_LOGIN=false

# Đăng nhập Google và gửi email (để trống nếu chưa có)
GOOGLE_CLIENT_ID=
SMTP_USER=
SMTP_PASS=

# Tác vụ tự động (phút/lần, 0 = tắt) và giới hạn gọi API đăng nhập mỗi 10 phút / IP
AUTO_JOB_MINUTES=15
AUTH_RATE_LIMIT=60
